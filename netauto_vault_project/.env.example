CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
NORNIR_CONFIG_FILE=/app/inventory/nornir_config.yaml
API_HOST=0.0.0.0
API_PORT=8000

# Vault connectivity
VAULT_ADDR=http://vault:8200
VAULT_NAMESPACE=
VAULT_KV_MOUNT=kv
VAULT_KV_VERSION=v2
VAULT_SECRET_PATH=network-automation/service-account
VAULT_ROLE_ID_FILE=/run/secrets/vault_role_id
VAULT_SECRET_ID_FILE=/run/secrets/vault_secret_id
VAULT_WRAPPED_SECRET_ID_FILE=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_TOKEN=
VAULT_AUTH_MODE=approle
VAULT_VERIFY=true
VAULT_TIMEOUT=10

# Parser/template behavior
NET_TEXTFSM=/app/templates/textfsm/ntc_templates/templates
PARSER_MAP_FILE=/app/data/parser_map.yaml
COMMAND_MAP_FILE=/app/data/command_map.yaml
VAULT_ROLE_MAP_FILE=/app/data/vault_roles.yaml
